# Copy to .env. Never commit your secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional expected seller ID; not required for single-merchant Standard Checkout.
# If set, a returned seller mismatch blocks capture/access. Never routes funds.
PAYPAL_MERCHANT_ID=
DATABASE_URL=sqlite:///instance/workshops.db
APP_ENV=development
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
PORT=8000
